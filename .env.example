# Configuração do copiloto. Copie para .env (opcional) ou defina as variáveis no terminal.
# Tudo tem padrão para rodar local; só a chave do Claude muda o comportamento.

# Chave da API do Claude. Prefira definir no terminal, sem gravar em arquivo:
#   PowerShell (vale para terminais novos): setx ANTHROPIC_API_KEY "sua-chave"
#   bash: export ANTHROPIC_API_KEY=sua-chave
# Sem chave, o assistente avisa que não está ligado e o console mostra o que falta.
# ANTHROPIC_API_KEY=

# Modelos (padrões recomendados)
# COPILOTO_MODELO=claude-opus-5-5
# COPILOTO_MODELO_RAPIDO=claude-haiku-5-5
# COPILOTO_ESFORCO=medium            # low, medium, high, xhigh ou max
# COPILOTO_LLM=simulado              # respostas por regras, só para testes (nunca liga sozinho)

# Portas e endereços
# PORT=3000                          # API do copiloto, copiloto.js e console compilado
# HORIZONTE_PORT=4000                # sistema de exemplo
# PUBLIC_URL=http://localhost:3000   # endereço público do copiloto (links de arquivos)
# CONSOLE_URL=http://localhost:5173  # endereço do console (links de convite)
# DATA_DIR=data                      # bancos SQLite (plataforma.db e empresas/<id>/), prints e arquivos

# Extensão do navegador (gravador de fluxos)
# EXTENSAO_URL_CHROME=               # página da extensão na Chrome Web Store; vazia: "Instalar o gravador" explica o pacote
# EXTENSAO_URL_EDGE=                 # página da extensão no Microsoft Edge Add-ons
# EXTENSAO_AJUDA_URL=                # "Como instalar pelo pacote"; padrão: a seção do README

# Plataforma (várias empresas)
# COPILOTO_CHAVE_MESTRA=             # cifra os segredos das empresas no banco; sem ela, deriva do SESSAO_SEGREDO
# COPILOTO_ADMINS=voce@starta.com.br # equipe Starta: cada e-mail recebe o link de ativação da Plataforma (também no log)
# COPILOTO_CADASTRO=aberto           # fechado: empresas novas só entram por convite
# EMAIL_VENDAS=vendas@starta.com.br  # recebe os pedidos do site, os de mudança de plano e as faturas a cobrar (cobrança manual); sem ela, ficam só no banco
# TEXTOS_LEGAIS_DIR=                 # pasta com termos.md, privacidade.md e contrato-lgpd.md aprovados; sem ela, o site mostra as minutas de docs/legal

# Cobrança pelo Asaas (sem a chave, a cobrança é manual: a Starta envia por e-mail e marca como paga na Plataforma)
# PowerShell: $env:ASAAS_API_KEY = '$aact_...'   (aspas simples, por causa do $)
# ASAAS_API_KEY=                     # chave da conta do Asaas
# ASAAS_AMBIENTE=sandbox             # sandbox ou producao
# ASAAS_WEBHOOK_TOKEN=               # token do webhook do Asaas, apontado para {PUBLIC_URL}/api/pagamentos/asaas
# ASAAS_NOTA_FISCAL=0                # 1 emite a nota fiscal de serviço a cada fatura paga
# ASAAS_NF_SERVICO_ID=               # id do serviço municipal no Asaas (ou ASAAS_NF_SERVICO_CODIGO, o código da prefeitura)
# ASAAS_NF_SERVICO_NOME=             # descrição do serviço na nota fiscal
# ASAAS_NF_IMPOSTOS=                 # percentuais, ex.: iss=2,pis=0.65,cofins=3,reterIss=0

# Sistema da demonstração (empresa Horizonte; empresas novas configuram o delas no console)
# ADAPTADOR=exemplo                  # pasta em server/src/adaptadores/
# SISTEMA_NOME=Horizonte
# SISTEMA_URL=http://localhost:4000  # telas do sistema
# SISTEMA_API_URL=http://localhost:4000
# SISTEMA_CHAVE_SERVICO=chave-servico-local

# Widget e segurança (troque em produção)
# WIDGET_CHAVE_PUBLICA=pk_local_horizonte   # chave e segredo da demonstração; cada empresa nova ganha os seus
# WIDGET_SEGREDO=segredo-widget-local
# WIDGET_EXIGIR_ASSINATURA=1
# SESSAO_SEGREDO=segredo-sessao-local-troque-em-producao

# Custos mostrados no console
# COTACAO_DOLAR=5.4
# CUSTO_NAVEGADOR_MINUTO=0.6

# Navegador das tarefas pela tela
# CHROMIUM_PATH=                     # Chromium já instalado (opcional)
# NAVEGADOR_VISIVEL=0                # 1 mostra o navegador (para depurar fluxos)
# COPILOTO_SEED=1                    # 0 não grava os dados de exemplo no primeiro início
