{
  "name": "@copiloto/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensão do navegador (Chrome e Edge) que grava fluxos para o copiloto em qualquer site.",
  "scripts": {
    "build": "tsx build/compilar.ts",
    "dev": "tsx build/compilar.ts --observar",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@copiloto/shared": "*",
    "@copiloto/widget": "*"
  },
  "devDependencies": {
    "@copiloto/server": "*",
    "@copiloto/sistema-exemplo": "*",
    "@types/node": "^22.18.10",
    "jsdom": "^27.0.0",
    "playwright": "1.56.1",
    "vite": "^7.1.10"
  }
}
