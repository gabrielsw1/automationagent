{
  "name": "copiloto",
  "private": true,
  "version": "0.1.0",
  "description": "Copiloto: assistente que executa tarefas dentro do seu sistema, com Claude.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "sample-system",
    "console",
    "widget",
    "extension"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w widget && npm run build -w console && npm run build -w extension",
    "start": "npm run build && node scripts/start.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w server",
    "setup": "npx playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
